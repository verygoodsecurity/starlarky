# strip() with no argument removes Unicode whitespace.
assert_eq("\u3000x\u2000".strip(), "x")
assert_eq("\u3000x\u2000".lstrip(), "x\u2000")
assert_eq("\u3000x\u2000".rstrip(), "\u3000x")
assert_eq("\x1c\x1dx\x1e\x1f".strip(), "x")
assert_eq("\x1c\x1dx\x1e\x1f".lstrip(), "x\x1e\x1f")
assert_eq("\x1c\x1dx\x1e\x1f".rstrip(), "\x1c\x1dx")
assert_eq("\u200bx\u200b".strip(), "\u200bx\u200b")
assert_eq("\u200bx\u200b".lstrip(), "\u200bx\u200b")
assert_eq("\u200bx\u200b".rstrip(), "\u200bx\u200b")
assert_eq("\u00a0\u0085x\u2028\u2029".strip(), "x")
assert_eq("\u00a0\u0085x\u2028\u2029".lstrip(), "x\u2028\u2029")
assert_eq("\u00a0\u0085x\u2028\u2029".rstrip(), "\u00a0\u0085x")
assert_eq("\u180ex\u180e".strip(), "\u180ex\u180e")
assert_eq("\u180ex\u180e".lstrip(), "\u180ex\u180e")
assert_eq("\u180ex\u180e".rstrip(), "\u180ex\u180e")
assert_eq(" \x09 x \x0a".strip(), "x")
assert_eq(" \x09 x \x0a".lstrip(), "x \x0a")
assert_eq(" \x09 x \x0a".rstrip(), " \x09 x")
