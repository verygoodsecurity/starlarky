assert_fails(lambda: "".rindex("c", -1), "substring not found")
assert_eq("".find("c", None, 0), -1)
assert_eq("".rfind("c", None, 0), -1)
assert_eq("".count("c", None, 0), 0)
assert_eq("".startswith("c", None, 0), False)
assert_eq("".endswith("c", None, 0), False)
assert_fails(lambda: "".index("c", None, 0), "substring not found")
assert_fails(lambda: "".rindex("c", None, 0), "substring not found")
assert_eq("".find("c", 1, 1), -1)
assert_eq("".rfind("c", 1, 1), -1)
assert_eq("".count("c", 1, 1), 0)
assert_eq("".startswith("c", 1, 1), False)
assert_eq("".endswith("c", 1, 1), False)
assert_fails(lambda: "".index("c", 1, 1), "substring not found")
assert_fails(lambda: "".rindex("c", 1, 1), "substring not found")
assert_eq("".startswith(("x", "")), True)
assert_eq("".endswith(("x", "")), True)
assert_eq("".startswith(("x", ""), 0), True)
assert_eq("".endswith(("x", ""), 0), True)
assert_eq("".startswith(("x", ""), 3), False)
assert_eq("".endswith(("x", ""), 3), False)
assert_eq("".startswith(("x", ""), 4), False)
assert_eq("".endswith(("x", ""), 4), False)
assert_eq("".startswith(("x", ""), 7), False)
assert_eq("".endswith(("x", ""), 7), False)
assert_eq("".startswith(("x", ""), 2, 1), False)
assert_eq("".endswith(("x", ""), 2, 1), False)
assert_eq("".startswith(("x", ""), 5, 10), False)
assert_eq("".endswith(("x", ""), 5, 10), False)
assert_eq("".startswith(("x", ""), -10), True)
assert_eq("".endswith(("x", ""), -10), True)
assert_eq("".startswith(("x", ""), 1, -5), False)
assert_eq("".endswith(("x", ""), 1, -5), False)
assert_eq("".startswith(("x", ""), 3, 3), False)
assert_eq("".endswith(("x", ""), 3, 3), False)
assert_eq("".startswith(("x", ""), 2, 2), False)
assert_eq("".endswith(("x", ""), 2, 2), False)
assert_eq("".startswith(("x", ""), 0, -4), True)
assert_eq("".endswith(("x", ""), 0, -4), True)
assert_eq("".startswith(("x", ""), -1), True)
assert_eq("".endswith(("x", ""), -1), True)
assert_eq("".startswith(("x", ""), None, 0), True)
assert_eq("".endswith(("x", ""), None, 0), True)
assert_eq("".startswith(("x", ""), 1, 1), False)
assert_eq("".endswith(("x", ""), 1, 1), False)

