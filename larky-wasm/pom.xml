<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.verygood.security</groupId>
    <artifactId>larky-wasm</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>larky-wasm</name>
    <description>WebAssembly runtimes for Larky's @vgs//wasm: Endive by default, GraalWasm optionally</description>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/verygoodsecurity/starlarky</url>
        </repository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>4.13.2</junit.version>
        <truth.version>1.4.4</truth.version>
        <endive.version>1.1.0</endive.version>
        <graalvm.version>25.4.4.1.1</graalvm.version>
    </properties>

    <dependencies>
        <!-- Endive: the default runtime. -->
        <dependency>
            <groupId>run.endive</groupId>
            <artifactId>runtime</artifactId>
            <version>${endive.version}</version>
        </dependency>
        <dependency>
            <groupId>run.endive</groupId>
            <artifactId>compiler</artifactId>
            <version>${endive.version}</version>
        </dependency>
        <dependency>
            <groupId>run.endive</groupId>
            <artifactId>simd</artifactId>
            <version>${endive.version}</version>
        </dependency>
        <!-- GraalWasm: optional. A consumer that sets -Dlarky.wasm.runtime=graal adds these itself. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>wasm-community</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- Compiles the WAT fixtures in src/test/resources/wasm when the tests run. -->
            <groupId>run.endive</groupId>
            <artifactId>wabt</artifactId>
            <version>${endive.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <version>${truth.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- Endive's SIMD interpreter (for modules with v128 instructions, e.g. Javy's) uses the Vector API. -->
                    <argLine>--add-modules jdk.incubator.vector</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- Larky's end-to-end tests use the fixtures (Fixtures and src/test/resources/wasm). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
