<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.verygood.security</groupId>
    <artifactId>larky-wasm-conformance</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>larky-wasm-conformance</name>
    <description>Runs the same WebAssembly modules on every runtime and checks they agree</description>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/verygoodsecurity/starlarky</url>
        </repository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>4.13.2</junit.version>
        <truth.version>1.4.4</truth.version>
        <endive.version>1.1.0</endive.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.verygood.security</groupId>
            <artifactId>larky-wasm-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- Truth brings guava-android, which would otherwise win over the -jre build Larky needs. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.0-jre</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.verygood.security</groupId>
            <artifactId>larky</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.verygood.security</groupId>
            <artifactId>larky-wasm-endive</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.verygood.security</groupId>
            <artifactId>larky-wasm-graal</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Compiles the WAT fixtures in src/test/resources/wasm when the tests run. -->
            <groupId>run.endive</groupId>
            <artifactId>wabt</artifactId>
            <version>${endive.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <version>${truth.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- Endive's SIMD interpreter (for modules with v128 instructions, e.g. Javy's) uses the Vector API. -->
                    <argLine>--add-modules jdk.incubator.vector</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
