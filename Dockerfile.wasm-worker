FROM maven:3.9.9-eclipse-temurin-21 AS build

WORKDIR /build/larky-wasm
COPY larky-wasm/pom.xml ./pom.xml
COPY larky-wasm/src ./src
RUN mvn -q -DskipTests package dependency:copy-dependencies \
    -DincludeScope=runtime -DexcludeGroupIds=org.graalvm.polyglot,org.graalvm.truffle
RUN mvn -q dependency:copy-dependencies -DincludeScope=test \
      -DexcludeGroupIds=org.graalvm.polyglot,org.graalvm.truffle \
      -DoutputDirectory=/build/trainer-lib && \
    mkdir /build/trainer && \
    javac --add-modules jdk.incubator.vector \
      -cp 'target/classes:target/dependency/*:/build/trainer-lib/*' -d /build/trainer \
      src/main/worker/ArchiveTrainingRequest.java && \
    java --add-modules jdk.incubator.vector \
      -cp '/build/trainer:target/classes:target/dependency/*:/build/trainer-lib/*' \
      com.verygood.security.larky.wasm.ArchiveTrainingRequest > /build/training-request.bin

FROM eclipse-temurin:21-jre AS archive
WORKDIR /app
RUN test -x /opt/java/openjdk/bin/java
COPY --from=build /build/larky-wasm/target/larky-wasm-1.0.0-SNAPSHOT.jar /app/worker.jar
COPY --from=build /build/larky-wasm/target/dependency/ /app/lib/
COPY --from=build /build/training-request.bin /app/training-request.bin
RUN /opt/java/openjdk/bin/java --add-modules jdk.incubator.vector \
      -Xmx256m -XX:MaxMetaspaceSize=64m \
      -XX:ArchiveClassesAtExit=/app/worker.jsa \
      -cp '/app/worker.jar:/app/lib/*' \
      com.verygood.security.larky.wasm.WorkerMain \
      < /app/training-request.bin > /app/training-response.bin && \
    test "$(od -An -tx1 -N5 /app/training-response.bin | tr -d ' \n')" = 4c574b3100 && \
    test -s /app/worker.jsa

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN test -x /opt/java/openjdk/bin/java
COPY --from=build /build/larky-wasm/target/larky-wasm-1.0.0-SNAPSHOT.jar /app/worker.jar
COPY --from=build /build/larky-wasm/target/dependency/ /app/lib/
COPY --from=archive --chmod=0444 /app/worker.jsa /app/worker.jsa
COPY --chmod=0555 larky-wasm/src/main/worker/server.sh /app/server.sh
COPY --chmod=0555 larky-wasm/src/main/worker/child.sh /app/child.sh
COPY --chmod=0555 larky-wasm/src/main/worker/plain-server.sh /app/plain-server.sh
COPY --chmod=0555 larky-wasm/src/main/worker/gateway.sh /app/gateway.sh
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/app/server.sh"]
