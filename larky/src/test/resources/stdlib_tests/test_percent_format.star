# (format, single operand, CPython's result)
SINGLE = [
    ("%s", 5, "5"),
    ("%d", 5, "5"),
    ("%5.1f", 2.25, "  2.2"),
    ("%s", [1, 2], "[1, 2]"),
    ("abc", {}, "abc"),
    ("abc", [], "abc"),
    ("%s", {"a": 1}, "{\"a\": 1}"),
    ("%(a)s", {"a": "x"}, "x"),
    ("%(a)-5d|", {"a": 3}, "3    |"),
    ("%((a))s", {"(a)": 1}, "1"),
    ("%(x)s %(y)05.1f %(x)r", {"x": 7, "y": 2.25}, "7 002.2 7"),
    ("%(a)s and %%", {"a": 1}, "1 and %"),
    ("%s %(a)s", {"a": 1}, "{\"a\": 1} 1"),
    ("%(a)s", {"a": 1, "b": 2}, "1"),
]


def _test_matches_cpython():
    for chunk in CASES_CHUNKS:
        for fmt, args, want in chunk:
            asserts.assert_that((fmt, args, fmt % args)).is_equal_to((fmt, args, want))


def _test_single_operand_and_mapping():
    for fmt, v, want in SINGLE:
        asserts.assert_that((fmt, v, fmt % v)).is_equal_to((fmt, v, want))


def _test_repr_and_ascii():
    # %r and %a use Starlark's repr, which quotes strings with double quotes
    asserts.assert_that("%r" % "a'b").is_equal_to("\"a'b\"")
    asserts.assert_that("%a" % "\u00e9\U0001F600").is_equal_to("\"\\xe9\\U0001f600\"")
    asserts.assert_that("%.3r" % "abc").is_equal_to("\"ab")


def _test_errors():
    asserts.assert_fails(lambda: "%(a)s %s" % {"a": 1}, "not enough arguments for format string")
    asserts.assert_fails(lambda: "%(a)s" % (1, ), "format requires a mapping")
    asserts.assert_fails(lambda: "%(b)s" % {"a": 1}, "key \"b\" not found")
    asserts.assert_fails(lambda: "%s %s" % (1, ), "not enough arguments for format string")
    asserts.assert_fails(lambda: "%s" % (1, 2, ), "not all arguments converted during string formatting")
    asserts.assert_fails(lambda: "abc" % 5, "not all arguments converted during string formatting")
    asserts.assert_fails(lambda: "%q" % 1, "unsupported format character 'q' \\(0x71\\) at index 1")
    asserts.assert_fails(lambda: "%" % (), "incomplete format")
    asserts.assert_fails(lambda: "%(a" % {"a": 1}, "incomplete format key")
    asserts.assert_fails(lambda: "%d" % "x", "%d format: a real number is required, not string")
    asserts.assert_fails(lambda: "%x" % "x", "%x format: an integer is required, not string")
    asserts.assert_fails(lambda: "%f" % "x", "%f format: must be real number, not string")
    asserts.assert_fails(lambda: "%c" % 1114112, "%c arg not in range\\(0x110000\\)")
    asserts.assert_fails(lambda: "%c" % "ab", "%c requires int or char")
    asserts.assert_fails(lambda: "%.*f" % ("a", 1.0, ), "\\* wants int")
    asserts.assert_fails(lambda: "%d" % float("inf"), "cannot convert float infinity to integer")
    asserts.assert_fails(lambda: "%d" % float("nan"), "cannot convert float NaN to integer")
    asserts.assert_fails(lambda: "%2000000d" % 1, "width too big")
    asserts.assert_fails(lambda: "%.2000000f" % 1.0, "precision too big")


def _suite():
    _suite = unittest.TestSuite()
    _suite.addTest(unittest.FunctionTestCase(_test_matches_cpython))
    _suite.addTest(unittest.FunctionTestCase(_test_single_operand_and_mapping))
    _suite.addTest(unittest.FunctionTestCase(_test_repr_and_ascii))
    _suite.addTest(unittest.FunctionTestCase(_test_errors))
    return _suite


_runner = unittest.TextTestRunner()
_runner.run(_suite())
