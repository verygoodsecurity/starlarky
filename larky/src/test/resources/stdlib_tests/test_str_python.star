def _test_bounds():
    for s, method, sub, start, end, want in _BOUNDS:
        got = getattr(s, method)(sub, start, end)
        asserts.assert_that(got).is_equal_to(want)
    asserts.assert_fails(lambda: "abc".index("", 4), "substring not found")
    asserts.assert_fails(lambda: "abc".rindex("", 2, 1), "substring not found")
    asserts.assert_that("abc".startswith(("x", ""), 4)).is_false()


