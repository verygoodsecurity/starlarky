def _test_unicode():
    for s, method, want in _UNICODE:
        got = getattr(s, method)()
        asserts.assert_that(got).is_equal_to(want)


def _suite():
    _suite = unittest.TestSuite()
    _suite.addTest(unittest.FunctionTestCase(_test_bounds))
    _suite.addTest(unittest.FunctionTestCase(_test_unicode))
    return _suite


_runner = unittest.TextTestRunner()
_runner.run(_suite())
