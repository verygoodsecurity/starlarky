    asserts.assert_that(codecs.encode("abc", "iso8859_16")).is_equal_to(b"\x61\x62\x63")
    asserts.assert_that(codecs.decode(b"\x61\x62\x63", "iso8859_16")).is_equal_to("abc")
    asserts.assert_that(codecs.encode("abc", "cp037")).is_equal_to(b"\x81\x82\x83")
    asserts.assert_that(codecs.decode(b"\x81\x82\x83", "cp037")).is_equal_to("abc")
