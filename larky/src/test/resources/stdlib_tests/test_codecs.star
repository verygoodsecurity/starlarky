def _testsuite():
    _suite = unittest.TestSuite()
    _suite.addTest(unittest.FunctionTestCase(_test_decode))
    _suite.addTest(unittest.FunctionTestCase(_test_encode))
    _suite.addTest(unittest.FunctionTestCase(_test_utf_8_decode))
    _suite.addTest(unittest.FunctionTestCase(_test_known_codecs))
    return _suite


_runner = unittest.TextTestRunner()
_runner.run(_testsuite())
