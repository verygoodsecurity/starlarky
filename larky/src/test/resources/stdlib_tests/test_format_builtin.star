def _test_matches_cpython():
    for chunk in CASES_CHUNKS:
        for value, spec, want in chunk:
            asserts.assert_that((value, spec, format(value, spec))).is_equal_to((value, spec, want))


def _test_default_spec():
    asserts.assert_that(format(1.5)).is_equal_to("1.5")
    asserts.assert_that(format("x")).is_equal_to("x")
    asserts.assert_that(format([1, 2])).is_equal_to("[1, 2]")  # str() of the value


def _Money__format__(self, spec):
    return "$" + format(self.amount, spec)


Money = type("Money", (object,), {
    "__init__": lambda self, amount: setattr(self, "amount", amount),
    "__format__": _Money__format__,
})
Plain = type("Plain", (object,), {})


def _test_dunder_format():
    asserts.assert_that(format(Money(1234.5), ",.2f")).is_equal_to("$1,234.50")
    s = larky.mutablestruct(__format__=lambda spec: "struct:" + spec)
    asserts.assert_that(format(s, "x")).is_equal_to("struct:x")
    asserts.assert_fails(lambda: format(Plain(), "x"), "unsupported format string passed to Plain.__format__")
    bad = larky.mutablestruct(__format__=lambda spec: 5)
    asserts.assert_fails(lambda: format(bad, ""), "__format__ must return a str, not int")


def _test_errors():
    asserts.assert_fails(lambda: format(5, ".2"), "Precision not allowed in integer format specifier")
    asserts.assert_fails(lambda: format(5, ",b"), "Cannot specify ',' with 'b'.")
    asserts.assert_fails(lambda: format(5, ",_"), "Cannot specify both ',' and '_'.")
    asserts.assert_fails(lambda: format("a", "+"), "Sign not allowed in string format specifier")
    asserts.assert_fails(lambda: format("a", "#"), "Alternate form \\(#\\) not allowed in string format specifier")
    asserts.assert_fails(lambda: format("a", "="), "'=' alignment not allowed in string format specifier")
    asserts.assert_fails(lambda: format("a", "d"), "Unknown format code 'd' for object of type 'str'")
    asserts.assert_fails(lambda: format(3.0, "d"), "Unknown format code 'd' for object of type 'float'")
    asserts.assert_fails(lambda: format(True, "s"), "Unknown format code 's' for object of type 'bool'")
    asserts.assert_fails(lambda: format(None, "s"), "unsupported format string passed to NoneType.__format__")
    asserts.assert_fails(lambda: format(5, "q"), "Unknown format code 'q' for object of type 'int'")
    asserts.assert_fails(lambda: format(5, "."), "Format specifier missing precision")
    asserts.assert_fails(lambda: format(5, "+c"), "Sign not allowed with integer format specifier 'c'")
    asserts.assert_fails(lambda: format(5, "#c"), "Alternate form \\(#\\) not allowed with integer format specifier 'c'")
    asserts.assert_fails(lambda: format(1114112, "c"), "%c arg not in range\\(0x110000\\)")
    asserts.assert_fails(lambda: format("a", ","), "Cannot specify ',' with 's'.")
    asserts.assert_fails(lambda: format(5, "5.2,3"), "Invalid format specifier")
    asserts.assert_fails(lambda: format(12345, ",n"), "Cannot specify ',' with 'n'.")
    asserts.assert_fails(lambda: format(, "e"), "int too large to convert to float")
    asserts.assert_fails(lambda: format(5, "2000000"), "width too big")
    asserts.assert_fails(lambda: format(5.0, ".2000000f"), "precision too big")
    asserts.assert_fails(lambda: format(5, "123456789"), "width too big")


def _suite():
    _suite = unittest.TestSuite()
    _suite.addTest(unittest.FunctionTestCase(_test_matches_cpython))
    _suite.addTest(unittest.FunctionTestCase(_test_default_spec))
    _suite.addTest(unittest.FunctionTestCase(_test_dunder_format))
    _suite.addTest(unittest.FunctionTestCase(_test_errors))
    return _suite


_runner = unittest.TextTestRunner()
_runner.run(_suite())
