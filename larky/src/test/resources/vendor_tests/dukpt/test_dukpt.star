# dukpt 1.0.1: (data, reset_counter(data), copy_counter(data))
_UPSTREAM_COUNTERS = [
    ("ffff9876543210e00000", "ffff9876543210e00000", "000000"),
    ("a24f4a6150363473892d", "a24f4a61503634600000", "13892d"),
    ("ffffff", "e00000", "1fffff"),
    ("123456789a", "1234400000", "16789a"),
    ("00ffffffff", "00ffe00000", "1fffff"),
]



def _hex(b):
    return b.hex()


def test_ansi_ipek():
    server = Server(_ANSI_BDK)
    asserts.assert_that(_hex(server.generate_ipek(_ANSI_KSN))).is_equal_to(_ANSI_IPEK)
    # The counter is cleared before either half is computed.
    for ksn in ["FFFF9876543210E00001", "FFFF9876543210E10000", "FFFF9876543210FFFFFF"]:
        asserts.assert_that(_hex(server.generate_ipek(unhexlify(ksn)))).is_equal_to(_ANSI_IPEK)


def test_ansi_server_keys():
    server = Server(_ANSI_BDK)
    for ksn, key in _ANSI_KEYS + _ANSI_HIGH:
        asserts.assert_that(_hex(server.gen_key(unhexlify(ksn)))).is_equal_to(key)
        asserts.assert_that(_hex(server.derive_key(unhexlify(_ANSI_IPEK), unhexlify(ksn)))).is_equal_to(key)


def test_ansi_client_sequence():
    client = Client(unhexlify(_ANSI_IPEK), _ANSI_KSN)
    for ksn, key in _ANSI_KEYS:
        info = client.gen_key()
        asserts.assert_that(_hex(info["ksn"])).is_equal_to(ksn)
        asserts.assert_that(_hex(info["key"])).is_equal_to(key)


def test_ansi_server_vectors():
    servers = [Server(unhexlify(b)) for b in _ANSI_BDKS]
    for i, ksn, ipek, key in _ANSI_SERVER:
        server = servers[i]
        k = unhexlify(ksn)
        asserts.assert_that(_hex(server.generate_ipek(k))).is_equal_to(ipek)
        asserts.assert_that(_hex(server.gen_key(k))).is_equal_to(key)
        asserts.assert_that(_hex(server._cur_key)).is_equal_to(key)
        asserts.assert_that(_hex(server.derive_key(unhexlify(ipek), k))).is_equal_to(key)


def test_ansi_client_vectors():
    for ipek, ksn, seq in _ANSI_CLIENT:
        client = Client(unhexlify(ipek), unhexlify(ksn))
        for expected_ksn, expected_key in seq:
            info = client.gen_key()
            asserts.assert_that(_hex(info["ksn"])).is_equal_to(expected_ksn)
            asserts.assert_that(_hex(info["key"])).is_equal_to(expected_key)


def test_upstream_agrees_below_0x200():
    servers = [Server(unhexlify(b)) for b in _ANSI_BDKS]
    for i, ksn, ipek, key in _UPSTREAM_LOW:
        k = unhexlify(ksn)
        asserts.assert_that(_hex(servers[i].generate_ipek(k))).is_equal_to(ipek)
        asserts.assert_that(_hex(servers[i].gen_key(k))).is_equal_to(key)


def test_upstream_counter_helpers():
    d = DUKPT(bdk=_ANSI_BDK)
    for data, reset, copy in _UPSTREAM_COUNTERS:
        got = d.reset_counter(unhexlify(data))
        if reset == None:
            asserts.assert_that(got).is_none()
        else:
            asserts.assert_that(_hex(got)).is_equal_to(reset)
        asserts.assert_that(_hex(d.copy_counter(unhexlify(data)))).is_equal_to(copy)
    asserts.assert_that(d.reset_counter(b"\xff\xff")).is_none()


def test_round_trip():
    # upstream example.py
    server = Server()
    asserts.assert_that(len(server.bdk)).is_equal_to(BDK_LEN)
    ksn = server.generate_ksn()
    asserts.assert_that(len(ksn)).is_equal_to(KSN_LEN)
    asserts.assert_that(_hex(server.copy_counter(ksn))).is_equal_to("000000")
    ipek = server.generate_ipek(ksn)
    asserts.assert_that(len(ipek)).is_equal_to(16)
    client = Client(ipek, ksn)
    seen = {}
    for _ in range(6):
        info = client.gen_key()
        asserts.assert_that(server.gen_key(info["ksn"])).is_equal_to(info["key"])
        seen[info["key"]] = True
    asserts.assert_that(len(seen)).is_equal_to(6)


def test_random_generation():
    server = Server(_ANSI_BDK)
    a = server.generate_bdk()
    b = server.generate_bdk()
    asserts.assert_that(len(a)).is_equal_to(BDK_LEN)
    asserts.assert_that(a == b).is_false()
    asserts.assert_that(Server().bdk == Server().bdk).is_false()
    asserts.assert_that(server.generate_ksn()[-2:]).is_equal_to(b"\x00\x00")


def test_client_counter_exhaustion():
    ipek = unhexlify(_ANSI_IPEK)
    # The counter is unsigned: 0x0FFFFF steps to 0x100000.
    client = Client(ipek, unhexlify("FFFF9876543210EFFFFE"))
    asserts.assert_that(_hex(client.gen_key()["ksn"])).is_equal_to("ffff9876543210efffff")
    asserts.assert_that(_hex(client.gen_key()["ksn"])).is_equal_to("ffff9876543210f00000")
    # 0x1FFFFF is the last counter: its key is returned, then gen_key fails.
    client = Client(ipek, unhexlify("FFFF9876543210FFFFFE"))
    info = client.gen_key()
    asserts.assert_that(_hex(info["ksn"])).is_equal_to("ffff9876543210ffffff")
    asserts.assert_that(_hex(info["key"])).is_equal_to(_ANSI_HIGH[-1][1])
    asserts.assert_fails(lambda: client.gen_key(), ".*?ValueError: KSN counter exhausted \\(0x1FFFFF\\)")
    asserts.assert_fails(lambda: client.increase_counter(), ".*?ValueError: KSN counter exhausted \\(0x1FFFFF\\)")
    asserts.assert_that(_hex(client._ksn)).is_equal_to("ffff9876543210ffffff")
    # A KSN that is already exhausted cannot start a Client.
    asserts.assert_fails(lambda: Client(ipek, unhexlify("FFFF9876543210FFFFFF")),
                         ".*?ValueError: KSN counter exhausted \\(0x1FFFFF\\)")


def test_attributes():
    d = DUKPT(ipek=unhexlify(_ANSI_IPEK), ksn=_ANSI_KSN)
    asserts.assert_that(d.BDK_LEN).is_equal_to(16)
    asserts.assert_that(d.KSN_LEN).is_equal_to(10)
    asserts.assert_that(dukpt.BDK_LEN).is_equal_to(16)
    asserts.assert_that(dukpt.KSN_LEN).is_equal_to(10)
    asserts.assert_that(_hex(d._pin_mask)).is_equal_to("00000000000000ff00000000000000ff")
    asserts.assert_that(_hex(d._mac_req_mask)).is_equal_to("000000000000ff00000000000000ff00")
    asserts.assert_that(_hex(d._mac_resp_mask)).is_equal_to("00000000ff00000000000000ff000000")
    asserts.assert_that(_hex(d._mac_data_req)).is_equal_to("0000000000ff00000000000000ff0000")
    asserts.assert_that(_hex(d._mac_data_resp)).is_equal_to("000000ff00000000000000ff00000000")
    asserts.assert_that(d._ksn).is_equal_to(_ANSI_KSN)
    asserts.assert_that(d._cur_key).is_none()
    asserts.assert_that(d.__name__).is_equal_to("DUKPT")
    asserts.assert_that(Server(_ANSI_BDK).__name__).is_equal_to("Server")
    asserts.assert_that(Client(unhexlify(_ANSI_IPEK), _ANSI_KSN).__name__).is_equal_to("Client")
    asserts.assert_that(dukpt.Server).is_equal_to(Server)


def test_bytearray_arguments():
    server = Server(bytearray(_ANSI_BDK))
    ksn, key = _ANSI_KEYS[2]
    asserts.assert_that(_hex(server.gen_key(bytearray(unhexlify(ksn))))).is_equal_to(key)
    client = Client(bytearray(unhexlify(_ANSI_IPEK)), bytearray(_ANSI_KSN))
    asserts.assert_that(_hex(client.gen_key()["key"])).is_equal_to(_ANSI_KEYS[0][1])


def test_invalid_arguments():
    asserts.assert_fails(lambda: DUKPT(), ".*?InvalidDUKPTArguments: Must have either ipek or bdk")
    asserts.assert_fails(lambda: DUKPT(bdk=b""), ".*?InvalidDUKPTArguments: Must have either ipek or bdk")
    asserts.assert_fails(lambda: Server(b"x" * 15), ".*?InvalidDUKPTArguments: BDK must have a length of 16")
    asserts.assert_fails(lambda: Server(b"x" * 17), ".*?InvalidDUKPTArguments: BDK must have a length of 16")
    asserts.assert_fails(lambda: Client(b"", _ANSI_KSN), ".*?InvalidDUKPTArguments: Must have either ipek or bdk")
    asserts.assert_fails(lambda: Client(None, _ANSI_KSN), ".*?InvalidDUKPTArguments: Must have either ipek or bdk")
    asserts.assert_fails(lambda: InvalidDUKPTArguments("boom"), ".*?InvalidDUKPTArguments: boom")


def test_type_and_length_errors():
    ipek = unhexlify(_ANSI_IPEK)
    asserts.assert_fails(lambda: Client(ipek, None), ".*?TypeError: ksn must be bytes; got NoneType")
    asserts.assert_fails(lambda: Server("0123456789abcdef"), ".*?TypeError: bdk must be bytes; got string")
    asserts.assert_fails(lambda: Client(ipek, b"\x00" * 8), ".*?ValueError: KSN must be 10 bytes; got 8")
    asserts.assert_fails(lambda: Client(ipek, b"\x00" * 12), ".*?ValueError: KSN must be 10 bytes; got 12")
    server = Server(_ANSI_BDK)
    asserts.assert_fails(lambda: server.gen_key("FFFF9876543210E00001"), ".*?TypeError: ksn must be bytes; got string")
    asserts.assert_fails(lambda: server.copy_counter(b"\xff\xff"), ".*?ValueError: Bitstrings must have the same length for & operator.")
    asserts.assert_fails(lambda: server.derive_key(ipek[:8], unhexlify("FFFF9876543210E00001")),
                         ".*?ValueError: Bitstrings must have the same length for \\^ operator.")


def _testsuite():
    _suite = unittest.TestSuite()
    _suite.addTest(unittest.FunctionTestCase(test_ansi_ipek))
    _suite.addTest(unittest.FunctionTestCase(test_ansi_server_keys))
    _suite.addTest(unittest.FunctionTestCase(test_ansi_client_sequence))
    _suite.addTest(unittest.FunctionTestCase(test_ansi_server_vectors))
    _suite.addTest(unittest.FunctionTestCase(test_ansi_client_vectors))
    _suite.addTest(unittest.FunctionTestCase(test_upstream_agrees_below_0x200))
